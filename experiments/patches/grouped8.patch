+pub fn name_len(key: u64, info: &OutInfo) -> usize {
+    if key & LINKED != 0 { deref(info.persons.names[(key & !LINKED) as usize]).len() }
+    else if key & HASHED_ID != 0 { let r = UNLINKED_NAMES.lock().unwrap().refs[(key & !HASHED_ID) as usize]; deref(r).len() }
+    else { let tag = (key & 15) as usize; if tag <= 8 { tag } else { 9 } }
+}
+pub fn name_bytes<'a>(key: u64, info: &OutInfo, buf: &'a mut [u8; 9]) -> &'a [u8] {
+    if key & LINKED != 0 { deref(info.persons.names[(key & !LINKED) as usize]) }
+    else if key & HASHED_ID != 0 { let r = UNLINKED_NAMES.lock().unwrap().refs[(key & !HASHED_ID) as usize]; deref(r) }
+    else { decode_short(key, buf) }
+}
